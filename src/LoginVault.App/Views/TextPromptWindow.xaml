<Window x:Class="LoginVault.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource FluentWindow}"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20">
    <TextBlock x:Name="MessageText" Style="{StaticResource FluentBodyText}" Margin="0,0,0,10" />
    <TextBox x:Name="InputBox" AutomationProperties.Name="入力" />
    <StackPanel Style="{StaticResource DialogButtons}">
      <Button Content="OK" Style="{StaticResource FluentAccentButton}" IsDefault="True" Click="Ok_Click" MinWidth="110" />
      <Button Content="キャンセル" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
