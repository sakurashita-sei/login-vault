<Window x:Class="LoginVault.App.Views.PasswordGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LoginVault.App.Controls"
        Title="パスワードの生成"
        Style="{StaticResource FluentWindow}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20">
    <TextBlock Text="文字数" Style="{StaticResource FluentBodyStrongText}" />
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <RadioButton Content="8 文字" GroupName="Length" IsChecked="{Binding LengthChoice, Converter={StaticResource EnumEquals}, ConverterParameter=Eight}" />
      <RadioButton Content="12 文字" GroupName="Length" Margin="16,0,0,0" IsChecked="{Binding LengthChoice, Converter={StaticResource EnumEquals}, ConverterParameter=Twelve}" />
      <RadioButton Content="16 文字" GroupName="Length" Margin="16,0,0,0" IsChecked="{Binding LengthChoice, Converter={StaticResource EnumEquals}, ConverterParameter=Sixteen}" />
      <RadioButton Content="自由入力" GroupName="Length" Margin="16,0,0,0" IsChecked="{Binding LengthChoice, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}" />
      <TextBox Width="72" Margin="8,0,0,0" Text="{Binding CustomLength, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomLength}" AutomationProperties.Name="文字数（自由入力）" />
      <TextBlock Style="{StaticResource FluentCaptionText}" VerticalAlignment="Center" Margin="8,0,0,0">
        <Run Text="（" /><Run Text="{Binding LengthRangeText, Mode=OneWay}" /><Run Text=" 文字）" />
      </TextBlock>
    </StackPanel>

    <TextBlock Text="文字" Style="{StaticResource FluentBodyStrongText}" Margin="0,16,0,0" />
    <WrapPanel Margin="0,6,0,0">
      <CheckBox Content="英字（大文字）" IsChecked="{Binding UseUppercase}" Margin="0,0,16,4" />
      <CheckBox Content="英字（小文字）" IsChecked="{Binding UseLowercase}" Margin="0,0,16,4" />
      <CheckBox Content="数字" IsChecked="{Binding UseDigits}" Margin="0,0,16,4" />
      <CheckBox Content="記号" IsChecked="{Binding UseSymbols}" Margin="0,0,16,4" />
    </WrapPanel>
    <!-- 記号ありのときだけ、各記号を使うかどうかを選べる（既定はすべて使う）。記号オフ時は非表示（D-053） -->
    <StackPanel x:Name="SymbolsPanel" Margin="24,2,0,0" Visibility="{Binding UseSymbols, Converter={StaticResource BoolToVisibility}}">
      <Button Content="{Binding ToggleAllSymbolsButtonText}" Command="{Binding ToggleAllSymbolsCommand}"
              HorizontalAlignment="Left" Margin="0,2,0,4" Padding="10,2" MinWidth="0" MinHeight="26"
              AutomationProperties.Name="{Binding ToggleAllSymbolsButtonText}"
              ToolTip="記号をすべて選択、またはすべて解除します" />
      <ItemsControl ItemsSource="{Binding Symbols}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsEnabled}" Margin="0,0,14,4" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Text="その他" Style="{StaticResource FluentBodyStrongText}" Margin="0,12,0,0" />
    <CheckBox Content="似通った英数字は省く（I・l・1・O・o・0）" IsChecked="{Binding ExcludeAmbiguous}" Margin="0,6,0,0" />
    <CheckBox Content="8 文字以内の場合、同じ文字は 2 回以上使わない" IsChecked="{Binding NoRepeatedCharacters}" Margin="0,4,0,0" />

    <TextBlock Text="生成したパスワード" Style="{StaticResource FluentFieldLabel}" Margin="0,16,0,6" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <!-- 候補のコピーが可能（利用者の指示、D-050）。クリックで全選択（D-051）。「この値を使う」でパスワード欄に入力できる -->
      <TextBox x:Name="CandidateBox" Text="{Binding Candidate, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{DynamicResource FluentValueFontFamily}" FontSize="16"
               IsUndoEnabled="False" AutomationProperties.Name="生成したパスワード"
               PreviewMouseLeftButtonDown="CandidateBox_PreviewMouseLeftButtonDown"
               GotKeyboardFocus="CandidateBox_GotKeyboardFocus" />
      <Button Grid.Column="1" Content="もう一度(_R)" Command="{Binding RegenerateCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
    </Grid>
    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FluentCriticalText}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" Margin="0,8,0,0" />
    <TextBlock Style="{StaticResource FluentCaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="「この値を使う」でパスワード欄に入ります（伏せ字のまま。目のアイコンで確認できます）。生成したパスワードは選択してコピー（Ctrl+C）することもできます。条件はアカウントの保存時に保管庫へ保存され、次回も同じ条件から始まります。" />
    <StackPanel Style="{StaticResource DialogButtons}">
      <Button x:Name="UseButton" Content="この値を使う(_U)" Style="{StaticResource FluentAccentButton}" IsDefault="True" Click="Use_Click" IsEnabled="{Binding CanAccept}" MinWidth="130" />
      <Button Content="キャンセル" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
