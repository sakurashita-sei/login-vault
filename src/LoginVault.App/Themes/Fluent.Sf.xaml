<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- SF テーマ: 参照デザイン「Login Vault — SF UI」の配色（濃紺の面にシアン #5EEAFF の線・光）。ライト／ダークと同じキーを定義する -->
  <Color x:Key="FluentWindowBackgroundColor">#070B12</Color>
  <Color x:Key="FluentLayerBackgroundColor">#060A10</Color>
  <Color x:Key="FluentCardBackgroundColor">#0A111B</Color>
  <Color x:Key="FluentCardStrokeColor">#245EEAFF</Color>
  <Color x:Key="FluentDividerColor">#1F5EEAFF</Color>
  <Color x:Key="FluentControlFillColor">#0A5EEAFF</Color>
  <Color x:Key="FluentControlFillHoverColor">#145EEAFF</Color>
  <Color x:Key="FluentControlFillPressedColor">#1F5EEAFF</Color>
  <Color x:Key="FluentControlFillDisabledColor">#0C1219</Color>
  <Color x:Key="FluentSubtleFillHoverColor">#0F5EEAFF</Color>
  <Color x:Key="FluentSubtleFillPressedColor">#145EEAFF</Color>
  <Color x:Key="FluentSubtleFillSelectedColor">#1F5EEAFF</Color>
  <Color x:Key="FluentControlStrokeColor">#385EEAFF</Color>
  <Color x:Key="FluentControlStrokeBottomColor">#425EEAFF</Color>
  <Color x:Key="FluentControlStrongStrokeColor">#705EEAFF</Color>
  <Color x:Key="FluentTextPrimaryColor">#EAF6FF</Color>
  <Color x:Key="FluentTextSecondaryColor">#B9C8D6</Color>
  <Color x:Key="FluentTextTertiaryColor">#8FA3B8</Color>
  <Color x:Key="FluentTextDisabledColor">#55657A</Color>
  <Color x:Key="FluentTextOnAccentColor">#04121A</Color>
  <Color x:Key="FluentAccentColor">#5EEAFF</Color>
  <Color x:Key="FluentAccentHoverColor">#B8F6FF</Color>
  <Color x:Key="FluentAccentPressedColor">#3ED2EA</Color>
  <Color x:Key="FluentAccentTextColor">#5EEAFF</Color>
  <Color x:Key="FluentFocusStrokeColor">#5EEAFF</Color>
  <Color x:Key="FluentCriticalTextColor">#FF8A7A</Color>
  <Color x:Key="FluentSuccessTextColor">#6CE0A8</Color>
  <Color x:Key="FluentCautionTextColor">#FFD08A</Color>
  <Color x:Key="FluentStatusBarBackgroundColor">#060A10</Color>

  <!-- ウィンドウ背景: 上部中央がわずかに明るい放射状グラデーション（参照デザインの glow） -->
  <RadialGradientBrush x:Key="FluentWindowBackgroundBrush" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.7">
    <GradientStop Color="#0C1829" Offset="0" />
    <GradientStop Color="{StaticResource FluentWindowBackgroundColor}" Offset="1" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="FluentLayerBackgroundBrush" Color="{StaticResource FluentLayerBackgroundColor}" />
  <SolidColorBrush x:Key="FluentCardBackgroundBrush" Color="{StaticResource FluentCardBackgroundColor}" />
  <SolidColorBrush x:Key="FluentCardStrokeBrush" Color="{StaticResource FluentCardStrokeColor}" />
  <SolidColorBrush x:Key="FluentDividerBrush" Color="{StaticResource FluentDividerColor}" />
  <SolidColorBrush x:Key="FluentControlFillBrush" Color="{StaticResource FluentControlFillColor}" />
  <SolidColorBrush x:Key="FluentControlFillHoverBrush" Color="{StaticResource FluentControlFillHoverColor}" />
  <SolidColorBrush x:Key="FluentControlFillPressedBrush" Color="{StaticResource FluentControlFillPressedColor}" />
  <SolidColorBrush x:Key="FluentControlFillDisabledBrush" Color="{StaticResource FluentControlFillDisabledColor}" />
  <SolidColorBrush x:Key="FluentSubtleFillHoverBrush" Color="{StaticResource FluentSubtleFillHoverColor}" />
  <SolidColorBrush x:Key="FluentSubtleFillPressedBrush" Color="{StaticResource FluentSubtleFillPressedColor}" />
  <SolidColorBrush x:Key="FluentSubtleFillSelectedBrush" Color="{StaticResource FluentSubtleFillSelectedColor}" />
  <SolidColorBrush x:Key="FluentControlStrokeBrush" Color="{StaticResource FluentControlStrokeColor}" />
  <SolidColorBrush x:Key="FluentControlStrokeBottomBrush" Color="{StaticResource FluentControlStrokeBottomColor}" />
  <SolidColorBrush x:Key="FluentControlStrongStrokeBrush" Color="{StaticResource FluentControlStrongStrokeColor}" />
  <SolidColorBrush x:Key="FluentTextPrimaryBrush" Color="{StaticResource FluentTextPrimaryColor}" />
  <SolidColorBrush x:Key="FluentTextSecondaryBrush" Color="{StaticResource FluentTextSecondaryColor}" />
  <SolidColorBrush x:Key="FluentTextTertiaryBrush" Color="{StaticResource FluentTextTertiaryColor}" />
  <SolidColorBrush x:Key="FluentTextDisabledBrush" Color="{StaticResource FluentTextDisabledColor}" />
  <SolidColorBrush x:Key="FluentTextOnAccentBrush" Color="{StaticResource FluentTextOnAccentColor}" />
  <SolidColorBrush x:Key="FluentAccentBrush" Color="{StaticResource FluentAccentColor}" />
  <SolidColorBrush x:Key="FluentAccentHoverBrush" Color="{StaticResource FluentAccentHoverColor}" />
  <SolidColorBrush x:Key="FluentAccentPressedBrush" Color="{StaticResource FluentAccentPressedColor}" />
  <SolidColorBrush x:Key="FluentAccentTextBrush" Color="{StaticResource FluentAccentTextColor}" />
  <SolidColorBrush x:Key="FluentFocusStrokeBrush" Color="{StaticResource FluentFocusStrokeColor}" />
  <SolidColorBrush x:Key="FluentCriticalTextBrush" Color="{StaticResource FluentCriticalTextColor}" />
  <SolidColorBrush x:Key="FluentSuccessTextBrush" Color="{StaticResource FluentSuccessTextColor}" />
  <SolidColorBrush x:Key="FluentCautionTextBrush" Color="{StaticResource FluentCautionTextColor}" />
  <SolidColorBrush x:Key="FluentStatusBarBackgroundBrush" Color="{StaticResource FluentStatusBarBackgroundColor}" />

  <!-- テーマ単位の形状・装飾。SF テーマで差し替える（ライト／ダークは従来の見た目を変えない値） -->
  <CornerRadius x:Key="FluentControlCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="FluentOverlayCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="FluentBadgeCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="FluentFocusVisualCornerRadius">0</CornerRadius>
  <sys:Double x:Key="FluentIndicatorRadius">0</sys:Double>
  <sys:Double x:Key="FluentAccentCornerCut">10</sys:Double>
  <FontFamily x:Key="FluentValueFontFamily">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
  <FontFamily x:Key="FluentDisplayFontFamily">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
  <Visibility x:Key="FluentHudVisibility">Visible</Visibility>
  <!-- 走査線: 3px ごとに 1px のシアン（3%）を重ねる -->
  <DrawingBrush x:Key="FluentScanlineBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute" Viewbox="0,0,3,3" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="#085EEAFF" Geometry="M0,0 L3,0 3,1 0,1 Z" />
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="FluentFieldFocusGlowBrush" Color="#1A5EEAFF" />
  <SolidColorBrush x:Key="FluentFieldFocusStrokeBrush" Color="#5EEAFF" />
  <SolidColorBrush x:Key="FluentCautionFillBrush" Color="#12FFB547" />
  <SolidColorBrush x:Key="FluentCautionStrokeBrush" Color="#66FFB547" />
  <SolidColorBrush x:Key="FluentTagStrokeBrush" Color="#5EEAFF" />
</ResourceDictionary>
