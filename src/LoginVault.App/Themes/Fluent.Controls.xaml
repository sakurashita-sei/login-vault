<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:themes="clr-namespace:LoginVault.App.Themes">
  <!-- 字体と寸法（Fluent 2 の型ランプ） -->
  <!-- 字体は Yu Gothic UI に統一（利用者の指示、D-030）。未導入環境では Segoe UI / Meiryo UI に落ちる -->
  <FontFamily x:Key="FluentFontFamily">Yu Gothic UI, Meiryo UI, Segoe UI</FontFamily>
  <FontFamily x:Key="FluentIconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <sys:Double x:Key="FluentCaptionFontSize">12</sys:Double>
  <sys:Double x:Key="FluentBodyFontSize">14</sys:Double>
  <sys:Double x:Key="FluentSubtitleFontSize">20</sys:Double>
  <sys:Double x:Key="FluentTitleFontSize">28</sys:Double>
  <!-- アクセントボタンの角を斜めに切るクリップ（切り落とし幅はテーマの FluentAccentCornerCut。0 なら切らない） -->
  <themes:CutCornerClipConverter x:Key="FluentCutCornerClip" />

  <!-- フォーカス表示（キーボード操作時に 2px の枠） -->
  <Style x:Key="FluentFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource FluentFocusStrokeBrush}" BorderThickness="2" CornerRadius="{DynamicResource FluentFocusVisualCornerRadius}" Margin="-3" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 文字スタイル -->
  <Style x:Key="FluentTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FluentDisplayFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FluentTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FluentSubtitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FluentDisplayFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FluentSubtitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FluentBodyStrongText" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FluentBodyText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FluentSecondaryText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FluentCaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FluentCaptionFontSize}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FluentCriticalText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FluentCriticalTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FluentFieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <!-- SF テーマだけに現れる HUD 風の小見出し（等幅の英字。他のテーマでは Collapsed） -->
  <Style x:Key="FluentHudLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource FluentValueFontFamily}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextTertiaryBrush}" />
    <Setter Property="Visibility" Value="{DynamicResource FluentHudVisibility}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <!-- 左上と右下に括弧状の飾りを付ける枠（SF テーマだけ表示）。中身はそのまま表示する -->
  <Style x:Key="FluentHudFrame" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <ContentPresenter />
            <Border Width="12" Height="12" BorderThickness="2,2,0,0" BorderBrush="{DynamicResource FluentAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1" IsHitTestVisible="False" Visibility="{DynamicResource FluentHudVisibility}" />
            <Border Width="12" Height="12" BorderThickness="0,0,2,2" BorderBrush="{DynamicResource FluentAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-1" IsHitTestVisible="False" Visibility="{DynamicResource FluentHudVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 標準ボタン -->
  <Style x:Key="FluentButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource FluentControlFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource FluentControlCornerRadius}" />
            <Border x:Name="Edge" BorderBrush="{DynamicResource FluentControlStrokeBottomBrush}" BorderThickness="0,0,0,1" CornerRadius="{DynamicResource FluentControlCornerRadius}" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillPressedBrush}" />
              <Setter TargetName="Edge" Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
              <Setter TargetName="Edge" Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource FluentButton}" />

  <!-- アクセント（主操作）ボタン -->
  <Style x:Key="FluentAccentButton" TargetType="Button" BasedOn="{StaticResource FluentButton}">
    <Setter Property="Background" Value="{DynamicResource FluentAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Tag="{DynamicResource FluentAccentCornerCut}">
            <Grid.Clip>
              <MultiBinding Converter="{StaticResource FluentCutCornerClip}">
                <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
                <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight" />
                <Binding RelativeSource="{RelativeSource Self}" Path="Tag" />
              </MultiBinding>
            </Grid.Clip>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource FluentControlCornerRadius}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentAccentHoverBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentAccentHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentAccentPressedBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentAccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- アイコンボタン（背景なし。入力欄の右側やカード内の操作に使う。Content にグリフを入れる） -->
  <Style x:Key="FluentIconButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="FontFamily" Value="{StaticResource FluentIconFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource FluentControlCornerRadius}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillPressedBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 開閉式の見出し（アカウント編集の「詳細設定」など）。文字の右に下向き／上向きの山形を出す（D-045） -->
  <Style x:Key="FluentDisclosureButton" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource FluentControlCornerRadius}" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12" FontWeight="Normal" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillPressedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 入力欄（TextBox／PasswordBox 共通の見た目。下辺のみ濃い線、フォーカスでアクセント 2px）
       注意: TextBox／PasswordBox は Padding を内部で本文領域に適用するため、PART_ContentHost に Margin を重ねない（重ねると高さが約 44px になる） -->
  <ControlTemplate x:Key="FluentTextBoxTemplate" TargetType="TextBoxBase">
    <Grid>
      <Border x:Name="Glow" BorderBrush="{DynamicResource FluentFieldFocusGlowBrush}" BorderThickness="3" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False" />
      <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource FluentControlCornerRadius}" SnapsToDevicePixels="True">
        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
      </Border>
      <Border x:Name="Underline" BorderBrush="{DynamicResource FluentControlStrongStrokeBrush}" BorderThickness="0,0,0,1" CornerRadius="{DynamicResource FluentControlCornerRadius}" IsHitTestVisible="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillHoverBrush}" />
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
        <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentFieldFocusStrokeBrush}" />
        <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
        <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
        <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
        <Setter TargetName="Underline" Property="Visibility" Value="Collapsed" />
        <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="FluentValidationErrorTemplate">
    <Grid>
      <Border BorderBrush="{DynamicResource FluentCriticalTextBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentControlCornerRadius}" />
      <AdornedElementPlaceholder />
    </Grid>
  </ControlTemplate>
  <Style x:Key="FluentTextBox" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="{DynamicResource FluentControlFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource FluentAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FluentValidationErrorTemplate}" />
    <Setter Property="Template" Value="{StaticResource FluentTextBoxTemplate}" />
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource FluentTextBox}" />
  <Style x:Key="FluentPasswordBox" TargetType="PasswordBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="{DynamicResource FluentControlFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource FluentAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="PasswordChar" Value="●" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Grid>
            <Border x:Name="Glow" BorderBrush="{DynamicResource FluentFieldFocusGlowBrush}" BorderThickness="3" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource FluentControlCornerRadius}" SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Border>
            <Border x:Name="Underline" BorderBrush="{DynamicResource FluentControlStrongStrokeBrush}" BorderThickness="0,0,0,1" CornerRadius="{DynamicResource FluentControlCornerRadius}" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentFieldFocusStrokeBrush}" />
              <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
              <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
              <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
              <Setter TargetName="Underline" Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource FluentPasswordBox}" />

  <!-- 枠付き入力欄の中に文字と右側アイコンを並べるための「枠だけ」のスタイル（SecretField／PasswordEntryField が使う） -->
  <Style x:Key="FluentFieldBorder" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource FluentControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource FluentControlCornerRadius}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <!-- 枠の中に置く、装飾なしの TextBox（読み取り専用表示と入力欄の両方で使う） -->
  <Style x:Key="FluentInnerTextBox" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource FluentAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentInnerPasswordBox" TargetType="PasswordBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource FluentAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="PasswordChar" Value="●" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- チェックボックス -->
  <Style x:Key="FluentCheckBox" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="20" Height="20" CornerRadius="{DynamicResource FluentControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource FluentControlStrongStrokeBrush}" Background="{DynamicResource FluentControlFillBrush}" VerticalAlignment="Center">
              <TextBlock x:Name="Glyph" Text="&#xE73E;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12" Foreground="{DynamicResource FluentTextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource FluentAccentBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
              <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource FluentCheckBox}" />

  <!-- トグルスイッチ（Fluent 2 仕様: 幅 40、高さ 20、つまみ直径 12） -->
  <Style x:Key="FluentToggleSwitch" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource FluentControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentControlStrongStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- トラック（外枠・背景） -->
            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    VerticalAlignment="Center">
              <!-- つまみ（Thumb） -->
              <Ellipse x:Name="Thumb" Width="12" Height="12"
                       Fill="{DynamicResource FluentTextSecondaryBrush}"
                       HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource FluentAccentBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource FluentTextOnAccentBrush}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource FluentTextPrimaryBrush}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource FluentAccentHoverBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FluentAccentHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
              <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource FluentTextDisabledBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ラジオボタン -->
  <Style x:Key="FluentRadioButton" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,2,20,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="20" Height="20" VerticalAlignment="Center">
              <Ellipse x:Name="Outer" Stroke="{DynamicResource FluentControlStrongStrokeBrush}" StrokeThickness="1" Fill="{DynamicResource FluentControlFillBrush}" />
              <Ellipse x:Name="Inner" Width="8" Height="8" Fill="{DynamicResource FluentTextOnAccentBrush}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource FluentAccentBrush}" />
              <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource FluentAccentBrush}" />
              <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource FluentControlStrokeBrush}" />
              <Setter TargetName="Outer" Property="Fill" Value="{DynamicResource FluentControlFillDisabledBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource FluentRadioButton}" />

  <!-- ラベルとツールチップ -->
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Padding" Value="0,0,0,6" />
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentCardStrokeBrush}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentControlCornerRadius}" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" MaxWidth="360">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
