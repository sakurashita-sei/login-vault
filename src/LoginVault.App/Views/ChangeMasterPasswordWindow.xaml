<Window x:Class="LoginVault.App.Views.ChangeMasterPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LoginVault.App.Controls"
        Title="マスターパスワードの変更"
        Style="{StaticResource FluentWindow}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20">
    <TextBlock Style="{StaticResource FluentBodyText}" Margin="0,0,0,16" Text="保管庫を新しいマスターパスワードで暗号化し直します。以前のバックアップは旧マスターパスワードのまま残ります。新しいマスターパスワードを忘れると復元できません。" />
    <controls:PasswordEntryField x:Name="CurrentField" Label="現在のマスターパスワード" AutomationName="現在のマスターパスワード" />
    <controls:PasswordEntryField x:Name="NewField" Label="新しいマスターパスワード" AutomationName="新しいマスターパスワード" Margin="0,14,0,0" />
    <controls:PasswordEntryField x:Name="ConfirmField" Label="新しいマスターパスワード（確認）" AutomationName="新しいマスターパスワード（確認）" Margin="0,14,0,0" />
    <TextBlock x:Name="ErrorText" Style="{StaticResource FluentCriticalText}" Margin="0,10,0,0" Visibility="Collapsed" />
    <StackPanel Style="{StaticResource DialogButtons}">
      <Button Content="変更(_S)" Style="{StaticResource FluentAccentButton}" IsDefault="True" Click="Change_Click" MinWidth="110" />
      <Button Content="キャンセル" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
