<Window x:Class="LoginVault.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Style="{StaticResource FluentWindow}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="24,20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Label Grid.Row="0" Content="無操作でロックするまで（分）(_L)" Target="{Binding ElementName=LockBox}" VerticalAlignment="Center" Padding="0" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="LockBox" Text="{Binding AutoLockMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" AutomationProperties.Name="無操作でロックするまでの分数" />
      <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AutoLockRangeText}" Style="{StaticResource FluentCaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
      <Label Grid.Row="1" Content="パスワード表示時間（秒）(_R)" Target="{Binding ElementName=RevealBox}" VerticalAlignment="Center" Padding="0" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="RevealBox" Text="{Binding RevealSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" AutomationProperties.Name="パスワード表示時間の秒数" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RevealRangeText}" Style="{StaticResource FluentCaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
      <Label Grid.Row="2" Content="コピー消去までの時間（秒）(_C)" Target="{Binding ElementName=ClipboardBox}" VerticalAlignment="Center" Padding="0" />
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClipboardBox" Text="{Binding ClipboardClearSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" AutomationProperties.Name="コピー消去までの秒数" />
      <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ClipboardRangeText}" Style="{StaticResource FluentCaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
      <Label Grid.Row="3" Content="自動バックアップの世代数(_B)" Target="{Binding ElementName=BackupBox}" VerticalAlignment="Center" Padding="0" />
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="BackupBox" Text="{Binding BackupGenerations, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" AutomationProperties.Name="自動バックアップの世代数" />
      <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BackupRangeText}" Style="{StaticResource FluentCaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" />
    </Grid>
    <TextBlock Style="{StaticResource FluentCaptionText}" Margin="0,12,0,0">
      <Run Text="保存先: " /><Run Text="{Binding DataDirectory, Mode=OneWay}" />
    </TextBlock>
    <TextBlock Style="{StaticResource FluentCaptionText}" Margin="0,4,0,0" Text="自動バックアップは保存先の backups フォルダーに暗号化されたまま保存されます。削除済み・変更前の情報もバックアップには残ります。" />
    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FluentCriticalText}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" Margin="0,8,0,0" />
    <StackPanel Style="{StaticResource DialogButtons}">
      <Button Content="保存(_S)" Style="{StaticResource FluentAccentButton}" IsDefault="True" Click="Save_Click" MinWidth="110" />
      <Button Content="キャンセル" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
