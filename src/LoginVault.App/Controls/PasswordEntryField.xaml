<UserControl x:Class="LoginVault.App.Controls.PasswordEntryField"
             x:Name="Self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LoginVault.App.Controls"
             Focusable="False">
  <StackPanel>
    <TextBlock Text="{Binding Label, ElementName=Self}" Style="{StaticResource FluentFieldLabel}"
               Visibility="{Binding Label, ElementName=Self, Converter={StaticResource StringToVisibility}}" />
    <Grid>
    <Border BorderBrush="{DynamicResource FluentFieldFocusGlowBrush}" BorderThickness="3" Margin="-3" IsHitTestVisible="False"
            Visibility="{Binding IsKeyboardFocusWithin, ElementName=Self, Converter={StaticResource BoolToVisibility}}" />
    <Border x:Name="Frame">
      <Border.Style>
        <!-- TextBox と同じ見た目: フォーカスで枠線色が変わり、無効時は塗りが変わる -->
        <Style TargetType="Border" BasedOn="{StaticResource FluentFieldBorder}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Self}" Value="True">
              <Setter Property="Background" Value="{DynamicResource FluentCardBackgroundBrush}" />
              <Setter Property="BorderBrush" Value="{DynamicResource FluentFieldFocusStrokeBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, ElementName=Self}" Value="False">
              <Setter Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource FluentInnerPasswordBox}" PasswordChanged="PasswordBox_PasswordChanged"
                     AutomationProperties.Name="{Binding AutomationName, ElementName=Self}" />
        <!-- 表示中の平文: コピー・切り取り・ドラッグ・右クリックメニュー・Undo 履歴を持たず（除外形式なしの持ち出し経路を作らない）、IME にはパスワード欄として伝える（学習・予測の抑止。効き方は IME 次第） -->
        <TextBox x:Name="PlainBox" Style="{StaticResource FluentInnerTextBox}" Visibility="Collapsed" FontFamily="{DynamicResource FluentValueFontFamily}"
                 ContextMenu="{x:Null}" IsUndoEnabled="False" InputScope="Password" controls:ClipboardExport.IsBlocked="True"
                 TextChanged="PlainBox_TextChanged" AutomationProperties.Name="{Binding PlainAutomationName, ElementName=Self}" />
        <Button x:Name="RevealButton" Grid.Column="1" Click="Reveal_Click" ToolTip="入力中のパスワードを表示／非表示">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource FluentIconButton}">
              <Setter Property="Content" Value="&#xE7B3;" />
              <Setter Property="AutomationProperties.Name" Value="入力中のパスワードを表示" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRevealed, ElementName=Self}" Value="True">
                  <Setter Property="Content" Value="&#xED1A;" />
                  <Setter Property="AutomationProperties.Name" Value="入力中のパスワードを隠す" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </Border>
    <!-- フォーカス時の下線（TextBox と同じ: 通常 1px、フォーカス中はアクセント 2px） -->
    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource FluentControlCornerRadius}">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource FluentControlStrongStrokeBrush}" />
          <Setter Property="BorderThickness" Value="0,0,0,1" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Self}" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
              <Setter Property="BorderThickness" Value="0,0,0,2" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, ElementName=Self}" Value="False">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    </Border>
    </Grid>
  </StackPanel>
</UserControl>
