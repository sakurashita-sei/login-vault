<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 一覧（左ペインのナビゲーション風）。選択行は淡い塗りと左端のアクセント帯 -->
  <Style x:Key="FluentListBox" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style TargetType="ListBox" BasedOn="{StaticResource FluentListBox}" />
  <Style x:Key="FluentNavigationItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Root" Background="Transparent" CornerRadius="{DynamicResource FluentControlCornerRadius}" />
            <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="{DynamicResource FluentIndicatorRadius}" RadiusY="{DynamicResource FluentIndicatorRadius}" Fill="{DynamicResource FluentAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillSelectedBrush}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentNavigationItem}" />

  <!-- カード型の一覧行（右ペインのアカウント）。選択で枠線がアクセントになる -->
  <Style x:Key="FluentCardItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusVisual}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Root" Background="{DynamicResource FluentCardBackgroundBrush}" BorderBrush="{DynamicResource FluentCardStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentOverlayCornerRadius}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentControlStrongStrokeBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- コンボボックス -->
  <Style x:Key="FluentComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Grid>
            <Border x:Name="Root" Background="Transparent" CornerRadius="{DynamicResource FluentControlCornerRadius}" />
            <Rectangle x:Name="Indicator" Width="3" Height="16" RadiusX="{DynamicResource FluentIndicatorRadius}" RadiusY="{DynamicResource FluentIndicatorRadius}" Fill="{DynamicResource FluentAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillSelectedBrush}" />
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FluentComboBoxItem}" />
  <Style x:Key="FluentComboBox" TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FluentFocusVisual}" />
    <Setter Property="Background" Value="{DynamicResource FluentControlFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource FluentControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource FluentControlCornerRadius}" />
            <Border x:Name="Edge" BorderBrush="{DynamicResource FluentControlStrokeBottomBrush}" BorderThickness="0,0,0,1" CornerRadius="{DynamicResource FluentControlCornerRadius}" IsHitTestVisible="False" />
            <ToggleButton x:Name="Toggle" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <!-- DisplayMemberPath を反映するため ItemTemplateSelector も渡す -->
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{DynamicResource FluentIconFontFamily}" FontSize="12" Foreground="{DynamicResource FluentTextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide" Focusable="False"
                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <Border Background="{DynamicResource FluentCardBackgroundBrush}" BorderBrush="{DynamicResource FluentCardStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentOverlayCornerRadius}" Margin="0,4,0,0" Padding="0,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillHoverBrush}" />
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FluentAccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentControlFillDisabledBrush}" />
              <Setter TargetName="Edge" Property="Visibility" Value="Collapsed" />
              <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBox}" />

  <!-- メニュー（最上位とサブ項目のみ。サブメニューの入れ子は使わない） -->
  <Style TargetType="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource FluentDividerBrush}" />
    <Setter Property="Margin" Value="8,4" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Background="{TemplateBinding Background}" Height="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- MenuItem は Separator のスタイルをこのキーで探すため、同じスタイルを登録する -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}" />
  <ControlTemplate x:Key="FluentTopLevelMenuItem" TargetType="MenuItem">
    <Grid>
      <Border x:Name="Root" Background="Transparent" CornerRadius="{DynamicResource FluentControlCornerRadius}" Padding="10,6">
        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
      </Border>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide" Focusable="False">
        <Border Background="{DynamicResource FluentCardBackgroundBrush}" BorderBrush="{DynamicResource FluentCardStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentOverlayCornerRadius}" Padding="4" Margin="0,2,0,0" MinWidth="220">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillPressedBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="FluentSubmenuItem" TargetType="MenuItem">
    <Grid Background="Transparent" Margin="-4,0">
      <Border x:Name="Root" Background="Transparent" CornerRadius="{DynamicResource FluentControlCornerRadius}" Padding="10,7" Margin="4,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <!-- チェック可能な項目だけ左にチェック印の列を確保する -->
            <ColumnDefinition x:Name="CheckColumn" Width="0" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="CheckGlyph" Text="&#xE73E;" FontFamily="{DynamicResource FluentIconFontFamily}" FontSize="12" Foreground="{DynamicResource FluentAccentTextBrush}" VerticalAlignment="Center" Visibility="Hidden" />
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource FluentTextSecondaryBrush}" Margin="24,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsCheckable" Value="True">
        <Setter TargetName="CheckColumn" Property="Width" Value="22" />
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
      </Trigger>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <!-- 入れ子のサブメニューの見出し（「表示」→「テーマ」など）。右端に右向きの山形を出し、右側にポップアップを開く（D-047）。
       左のチェック印の列は、同じメニューのチェック可能な項目と文字の位置を揃えるために確保する -->
  <ControlTemplate x:Key="FluentSubmenuHeader" TargetType="MenuItem">
    <Grid Background="Transparent" Margin="-4,0">
      <Border x:Name="Root" Background="Transparent" CornerRadius="{DynamicResource FluentControlCornerRadius}" Padding="10,7" Margin="4,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{DynamicResource FluentIconFontFamily}" FontSize="10" Foreground="{DynamicResource FluentTextSecondaryBrush}" Margin="24,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right" HorizontalOffset="-4" VerticalOffset="-5" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
        <Border Background="{DynamicResource FluentCardBackgroundBrush}" BorderBrush="{DynamicResource FluentCardStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentOverlayCornerRadius}" Padding="4" MinWidth="200">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
      </Trigger>
      <Trigger Property="IsSubmenuOpen" Value="True">
        <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentSubtleFillHoverBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource FluentTextDisabledBrush}" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="Role" Value="TopLevelHeader">
        <Setter Property="Template" Value="{StaticResource FluentTopLevelMenuItem}" />
      </Trigger>
      <Trigger Property="Role" Value="TopLevelItem">
        <Setter Property="Template" Value="{StaticResource FluentTopLevelMenuItem}" />
      </Trigger>
      <Trigger Property="Role" Value="SubmenuItem">
        <Setter Property="Template" Value="{StaticResource FluentSubmenuItem}" />
      </Trigger>
      <Trigger Property="Role" Value="SubmenuHeader">
        <Setter Property="Template" Value="{StaticResource FluentSubmenuHeader}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- スクロールバー（細い帯とつまみだけ。配色はテーマに追従し、既定の明るいスクロールバーを置き換える） -->
  <Style x:Key="FluentScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentScrollBarThumb" TargetType="Thumb">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Root" Background="{DynamicResource FluentControlStrongStrokeBrush}" CornerRadius="{DynamicResource FluentControlCornerRadius}" Margin="3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentTextTertiaryBrush}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource FluentAccentBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="FluentVerticalScrollBar" TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource FluentScrollBarPageButton}" Command="ScrollBar.PageUpCommand" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource FluentScrollBarPageButton}" Command="ScrollBar.PageDownCommand" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource FluentScrollBarThumb}" />
        </Track.Thumb>
      </Track>
    </Border>
  </ControlTemplate>
  <ControlTemplate x:Key="FluentHorizontalScrollBar" TargetType="ScrollBar">
    <Border Background="{TemplateBinding Background}">
      <Track x:Name="PART_Track" IsDirectionReversed="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource FluentScrollBarPageButton}" Command="ScrollBar.PageLeftCommand" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource FluentScrollBarPageButton}" Command="ScrollBar.PageRightCommand" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource FluentScrollBarThumb}" />
        </Track.Thumb>
      </Track>
    </Border>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template" Value="{StaticResource FluentVerticalScrollBar}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template" Value="{StaticResource FluentHorizontalScrollBar}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- 細い区切り線と分割バー -->
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
  </Style>
</ResourceDictionary>
