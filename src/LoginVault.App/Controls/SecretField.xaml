<UserControl x:Class="LoginVault.App.Controls.SecretField"
             x:Name="Self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
  <StackPanel>
    <TextBlock Text="{Binding Label, ElementName=Self}" Style="{StaticResource FluentFieldLabel}"
               Visibility="{Binding Label, ElementName=Self, Converter={StaticResource StringToVisibility}}" />
    <Border Style="{StaticResource FluentFieldBorder}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- 本文は選択不可の TextBlock。コピーは右のボタン（履歴・同期除外、自動消去付き）だけに限定する -->
        <TextBlock x:Name="ValueText" Text="{Binding Text, ElementName=Self}" Margin="10,6" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{DynamicResource FluentValueFontFamily}"
                   AutomationProperties.Name="{Binding Label, ElementName=Self}" />
        <Button x:Name="RevealButton" Grid.Column="1"
                Command="{Binding RevealCommand, ElementName=Self}" CommandParameter="{Binding CommandParameter, ElementName=Self}"
                Visibility="{Binding ShowRevealButton, ElementName=Self, Converter={StaticResource BoolToVisibility}}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource FluentIconButton}">
              <Setter Property="Content" Value="&#xE7B3;" />
              <Setter Property="ToolTip" Value="表示（一定時間後、選択変更、非アクティブ化で自動的に隠れます）" />
              <Setter Property="AutomationProperties.Name" Value="{Binding RevealAutomationName, ElementName=Self}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRevealed, ElementName=Self}" Value="True">
                  <Setter Property="Content" Value="&#xED1A;" />
                  <Setter Property="ToolTip" Value="隠す" />
                  <Setter Property="AutomationProperties.Name" Value="{Binding HideAutomationName, ElementName=Self}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource FluentIconButton}" Content="&#xE8C8;"
                Command="{Binding CopyCommand, ElementName=Self}" CommandParameter="{Binding CommandParameter, ElementName=Self}"
                ToolTip="{Binding CopyToolTip, ElementName=Self}" AutomationProperties.Name="{Binding CopyAutomationName, ElementName=Self}" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
