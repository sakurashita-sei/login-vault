<Window x:Class="LoginVault.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LoginVault.App.Views"
        Title="{Binding WindowTitle, FallbackValue=Login Vault}"
        Style="{StaticResource FluentWindow}"
        Width="1040" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate x:Key="SetupTemplate">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate x:Key="UnlockTemplate">
      <views:UnlockView />
    </DataTemplate>
    <DataTemplate x:Key="VaultTemplate">
      <views:VaultView DataContext="{Binding Vault}" />
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <ContentControl Content="{Binding}" Focusable="False">
      <ContentControl.Style>
        <Style TargetType="ContentControl">
          <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="NeedsSetup">
              <Setter Property="ContentTemplate" Value="{StaticResource SetupTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Locked">
              <Setter Property="ContentTemplate" Value="{StaticResource UnlockTemplate}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Unlocked">
              <Setter Property="ContentTemplate" Value="{StaticResource VaultTemplate}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ContentControl.Style>
    </ContentControl>
    <!-- SF テーマの走査線。他のテーマでは Collapsed。操作は透過する -->
    <Rectangle Fill="{DynamicResource FluentScanlineBrush}" IsHitTestVisible="False" Visibility="{DynamicResource FluentHudVisibility}" />
  </Grid>
</Window>
