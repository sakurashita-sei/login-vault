<UserControl x:Class="LoginVault.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LoginVault.App.Controls"
             Background="{DynamicResource FluentWindowBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- SF テーマでは枠の左上・右下に括弧状の飾りが付く（FluentHudFrame） -->
    <!-- パス表示をやめてもカードの幅感が変わらないよう最小幅を持たせる（D-035） -->
    <ContentControl Style="{StaticResource FluentHudFrame}" MinWidth="480" MaxWidth="520" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Padding="32"
            Background="{DynamicResource FluentCardBackgroundBrush}" BorderBrush="{DynamicResource FluentCardStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentOverlayCornerRadius}">
      <StackPanel>
        <TextBlock Style="{StaticResource FluentHudLabel}" Text="// VAULT LOCKED" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <!-- アプリアイコン（docs/アイコン と同じ画像。D-030） -->
          <Image Source="pack://application:,,,/LoginVault;component/Assets/icon-256.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
          <TextBlock Text="Login Vault" Style="{StaticResource FluentSubtitleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <!-- 保存先のパスはここには出さない（利用者の指示、D-035）。設定ダイアログで確認できる -->
        <TextBlock Text="マスターパスワードを入力して保管庫を解錠してください。" Style="{StaticResource FluentBodyText}" Margin="0,0,0,20" />
        <controls:PasswordEntryField x:Name="PasswordField" Label="マスターパスワード" AutomationName="マスターパスワード" />
        <!-- ロックした理由の通知（注意色の枠）。解錠の失敗は下の赤字で出す -->
        <Border Margin="0,12,0,0" Padding="12,8" BorderThickness="1" CornerRadius="{DynamicResource FluentControlCornerRadius}"
                Background="{DynamicResource FluentCautionFillBrush}" BorderBrush="{DynamicResource FluentCautionStrokeBrush}"
                Visibility="{Binding IsMessageNotice, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="14" Foreground="{DynamicResource FluentCautionTextBrush}" VerticalAlignment="Top" Margin="0,2,8,0" />
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource FluentCautionTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
        </Border>
        <TextBlock Text="{Binding Message}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource FluentCriticalText}">
              <Setter Property="Visibility" Value="{Binding Message, Converter={StaticResource StringToVisibility}}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMessageNotice}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource FluentHudLabel}" Margin="0,16,0,0" Text="AES-256-GCM · PBKDF2-HMAC-SHA256 · LOCAL FILE ONLY" />
        <Button Content="解錠(_U)" Style="{StaticResource FluentAccentButton}" Click="Unlock_Click" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0" MinWidth="120"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                ToolTip="マスターパスワードで保管庫を復号して開きます" />
      </StackPanel>
    </Border>
    </ContentControl>
  </ScrollViewer>
</UserControl>
