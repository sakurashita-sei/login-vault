<Application x:Class="LoginVault.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LoginVault.App.Views"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 配色は FluentTheme.Apply が起動時にライト／ダーク／SF へ差し替える -->
        <ResourceDictionary Source="Themes/Fluent.Light.xaml" />
        <ResourceDictionary Source="Themes/Fluent.Controls.xaml" />
        <ResourceDictionary Source="Themes/Fluent.Lists.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <views:StringNotEmptyToVisibilityConverter x:Key="StringToVisibility" />
      <views:StringEmptyToVisibilityConverter x:Key="EmptyStringToVisibility" />
      <views:InverseBooleanConverter x:Key="InverseBool" />
      <views:EnumEqualsConverter x:Key="EnumEquals" />
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

      <Style x:Key="DialogButtons" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,20,0,0" />
      </Style>
      <!-- ウィンドウ共通: 背景・文字色・字体 -->
      <Style x:Key="FluentWindow" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource FluentWindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource FluentFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FluentBodyFontSize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
