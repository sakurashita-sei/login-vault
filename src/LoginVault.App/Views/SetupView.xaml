<UserControl x:Class="LoginVault.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LoginVault.App.Controls"
             Background="{DynamicResource FluentWindowBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- SF テーマでは枠の左上・右下に括弧状の飾りが付く（FluentHudFrame） -->
    <ContentControl Style="{StaticResource FluentHudFrame}" MaxWidth="600" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Padding="32"
            Background="{DynamicResource FluentCardBackgroundBrush}" BorderBrush="{DynamicResource FluentCardStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentOverlayCornerRadius}">
      <StackPanel>
        <TextBlock Style="{StaticResource FluentHudLabel}" Text="// INITIAL SETUP" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <!-- アプリアイコン（docs/アイコン と同じ画像。D-030） -->
          <Image Source="pack://application:,,,/LoginVault;component/Assets/icon-256.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
          <TextBlock Text="Login Vault の初回設定" Style="{StaticResource FluentSubtitleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <!-- 保存先のパスはここには出さない（利用者の指示、D-030／D-035）。設定ダイアログで確認できる -->
        <TextBlock Text="{Binding SetupNotice}" Style="{StaticResource FluentBodyText}" Margin="0,0,0,20" />
        <controls:PasswordEntryField x:Name="PasswordField" Label="マスターパスワード" AutomationName="マスターパスワード" />
        <controls:PasswordEntryField x:Name="ConfirmField" Label="マスターパスワード（確認）" AutomationName="マスターパスワード（確認）" Margin="0,14,0,0" />
        <TextBlock Text="{Binding Message}" Style="{StaticResource FluentCriticalText}" Margin="0,12,0,0"
                   Visibility="{Binding Message, Converter={StaticResource StringToVisibility}}" />
        <Button Content="保管庫を作成(_S)" Style="{StaticResource FluentAccentButton}" Click="Create_Click" IsDefault="True" HorizontalAlignment="Right" Margin="0,20,0,0" MinWidth="140"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                ToolTip="入力したマスターパスワードで新しい暗号化保管庫を作成します" />
      </StackPanel>
    </Border>
    </ContentControl>
  </ScrollViewer>
</UserControl>
