<Window x:Class="LoginVault.App.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LoginVault.App.Controls"
        Title="{Binding Title}"
        Style="{StaticResource FluentWindow}"
        Width="660" SizeToContent="Height" MinWidth="540" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <!-- 余白は従来と同じ合計（横 24、縦 20）。SF テーマでは外側の枠に括弧状の飾りが付く -->
  <ContentControl Style="{StaticResource FluentHudFrame}" Margin="12">
  <DockPanel Margin="12,8,12,8">
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FluentCriticalText}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" Margin="0,8,0,0" />
      <StackPanel Style="{StaticResource DialogButtons}">
        <Button Content="保存(_S)" Style="{StaticResource FluentAccentButton}" IsDefault="True" Click="Save_Click" MinWidth="110" />
        <Button Content="キャンセル" IsCancel="True" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Style="{StaticResource FluentHudLabel}" Text="// ACCOUNT EDITOR" />
        <TextBlock Text="サービス名" Style="{StaticResource FluentFieldLabel}" />
        <ComboBox x:Name="ServiceCombo" ItemsSource="{Binding ServiceOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedService}" AutomationProperties.Name="サービス名">
          <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FluentComboBoxItem}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            </Style>
          </ComboBox.ItemContainerStyle>
        </ComboBox>
        <!-- 一覧の最後の「＋ 新しいサービスを追加…」を選ぶと、ここに新しいサービス名を入れる。保存時にアカウントとまとめて登録する（D-048） -->
        <TextBox x:Name="NewServiceBox" Text="{Binding NewServiceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="新しいサービス名"
                 Visibility="{Binding IsNewService, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Style="{StaticResource FluentCaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding IsNewService, Converter={StaticResource BoolToVisibility}}"
                   Text="保存すると、このサービスとアカウントをまとめて登録します。同じ名前のサービスがすでにあれば、そのサービスに追加します。" />

        <!-- 基本欄はサービス・ログインID・パスワード。ログインID項目に関連するため、登録済みメールからの選択トグルもここに配置（D-049） -->
        <TextBlock Text="ログインID" Style="{StaticResource FluentBodyStrongText}" Margin="0,20,0,6" />
        <!-- ログインIDは除外形式付きのコピーボタン（一覧画面）だけから持ち出せる。ここからのコピー・切り取り・ドラッグは遮断する -->
        <TextBox Text="{Binding LoginIdText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="ログインID"
                 controls:ClipboardExport.IsBlocked="True"
                 Visibility="{Binding UseDirectInput, Converter={StaticResource BoolToVisibility}}" />
        <ComboBox ItemsSource="{Binding EmailCandidates}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedEmailCandidate}" AutomationProperties.Name="参照するメールアカウント"
                  Visibility="{Binding UseEmailReference, Converter={StaticResource BoolToVisibility}}">
          <ComboBox.ItemContainerStyle>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource FluentComboBoxItem}">
              <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            </Style>
          </ComboBox.ItemContainerStyle>
        </ComboBox>
        <CheckBox x:Name="EmailReferenceToggle" Style="{StaticResource FluentToggleSwitch}"
                  Content="登録済みメールから選択"
                  IsChecked="{Binding UseEmailReference}"
                  IsEnabled="{Binding CanUseEmailReference}"
                  AutomationProperties.Name="登録済みメールから選択"
                  ToolTipService.ShowOnDisabled="True"
                  ToolTip="「メールアカウント：はい」で登録済みの情報から選びます。メールアカウント自身には使えません"
                  Margin="0,8,0,0" />

        <TextBlock Text="パスワード" Style="{StaticResource FluentBodyStrongText}" Margin="0,20,0,6" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding CanKeepPassword, Converter={StaticResource BoolToVisibility}}">
          <RadioButton Content="変更なし" IsChecked="{Binding PasswordMode, Converter={StaticResource EnumEquals}, ConverterParameter=Keep}" GroupName="PasswordMode" />
          <RadioButton Content="新しいパスワード" IsChecked="{Binding PasswordMode, Converter={StaticResource EnumEquals}, ConverterParameter=Set}" GroupName="PasswordMode" />
          <RadioButton Content="空欄にする" IsChecked="{Binding PasswordMode, Converter={StaticResource EnumEquals}, ConverterParameter=Clear}" GroupName="PasswordMode" />
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:PasswordEntryField x:Name="NewPasswordField" AutomationName="新しいパスワード" IsEnabled="{Binding IsPasswordEntryEnabled}" />
          <!-- 条件を選んで生成し、この欄に入れる（「変更なし」のときは自動で「新しいパスワード」に切り替わる。D-041） -->
          <Button Grid.Column="1" Content="生成(_G)..." Click="Generate_Click" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="条件を選んでパスワードを生成し、この欄に入れます" />
        </Grid>
        <TextBlock Style="{StaticResource FluentCaptionText}" Margin="0,4,0,0" Text="前後の空白や記号もそのまま保存します。空欄のまま保存すると確認が表示されます。" />

        <ToggleButton x:Name="DetailsToggle" Style="{StaticResource FluentDisclosureButton}" IsChecked="{Binding IsDetailsExpanded}" Margin="-8,16,0,0" HorizontalAlignment="Left"
                      AutomationProperties.Name="詳細設定" ToolTip="表示名・メールアカウント・二段階認証・メモを設定します">
          <TextBlock Text="{Binding DetailsHeaderText}" />
        </ToggleButton>
        <StackPanel x:Name="DetailsPanel" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="アカウント表示名" Style="{StaticResource FluentFieldLabel}" Margin="0,12,0,6" />
          <TextBox x:Name="LabelBox" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="アカウント表示名" ToolTip="メイン、サブなど。空欄の場合はログインIDが表示名になります" />

          <TextBlock Text="{Binding EmailAccountQuestionText}" Style="{StaticResource FluentBodyStrongText}" Margin="0,20,0,6" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="はい（Gmail などメールサービス自体のログイン情報）" IsChecked="{Binding IsEmailAccount}" GroupName="EmailAccount" />
            <RadioButton Content="いいえ" IsChecked="{Binding IsEmailAccount, Converter={StaticResource InverseBool}}" GroupName="EmailAccount" />
          </StackPanel>
          <TextBlock Style="{StaticResource FluentCaptionText}" Margin="0,4,0,0" Text="メールアドレスをIDに使うだけのサービス（Amazon など）は「いいえ」です。「はい」にすると他のアカウントのログインIDとして選択できるようになります。" />

          <TextBlock Text="二段階認証" Style="{StaticResource FluentBodyStrongText}" Margin="0,20,0,6" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="未設定" IsChecked="{Binding IsMfaNotConfigured}" GroupName="Mfa" ToolTip="二段階認証を設定していない、または未確認" />
            <RadioButton Content="設定あり" IsChecked="{Binding IsMfaConfigured}" GroupName="Mfa" />
          </StackPanel>
          <Grid IsEnabled="{Binding IsMfaEnabled}" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="170" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0" Content="SMS" IsChecked="{Binding UseSms}" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SmsDetail, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseSms}" Margin="0,3" AutomationProperties.Name="SMS の補足" ToolTip="電話番号の末尾などの補足（任意）" />
            <CheckBox Grid.Row="1" Content="メール" IsChecked="{Binding UseEmail}" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EmailDetail, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseEmail}" Margin="0,3" AutomationProperties.Name="メールの補足" ToolTip="送信先などの補足（任意）" />
            <CheckBox Grid.Row="2" Content="Authenticator" IsChecked="{Binding UseAuthenticator}" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AuthenticatorDetail, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseAuthenticator}" Margin="0,3" AutomationProperties.Name="Authenticator の補足" ToolTip="アプリ名や端末などの補足（任意）" />
            <CheckBox Grid.Row="3" Content="その他" IsChecked="{Binding UseOther}" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OtherName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseOther}" Margin="0,3" AutomationProperties.Name="その他の方式名" ToolTip="方式名（必須）" />
            <TextBlock Grid.Row="4" Text="その他の補足" Style="{StaticResource FluentCaptionText}" VerticalAlignment="Center" Margin="28,0,0,0" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OtherDetail, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseOther}" Margin="0,3" AutomationProperties.Name="その他の補足" ToolTip="補足（任意）" />
          </Grid>

          <TextBlock Text="メモ" Style="{StaticResource FluentFieldLabel}" Margin="0,20,0,6" />
          <TextBox x:Name="NotesBox" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="メモ" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </ContentControl>
</Window>
