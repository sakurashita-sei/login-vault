<UserControl x:Class="LoginVault.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:LoginVault.App.Controls"
             Background="{DynamicResource FluentWindowBackgroundBrush}">
  <UserControl.InputBindings>
    <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}" />
  </UserControl.InputBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Margin="8,4,8,0">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="バックアップを作成(_B)..." Command="{Binding CreateManualBackupCommand}" />
        <MenuItem Header="バックアップから復元(_R)..." Command="{Binding RestoreCommand}" />
        <Separator />
        <MenuItem Header="マスターパスワードの変更(_M)..." Command="{Binding ChangeMasterPasswordCommand}" />
        <MenuItem Header="設定(_S)..." Command="{Binding OpenSettingsCommand}" />
        <Separator />
        <MenuItem Header="ロック(_L)" Command="{Binding LockCommand}" InputGestureText="Ctrl+L" />
      </MenuItem>
      <MenuItem Header="サービス(_S)">
        <MenuItem Header="追加(_A)..." Command="{Binding AddServiceCommand}" />
        <MenuItem Header="名前の変更(_R)..." Command="{Binding RenameServiceCommand}" IsEnabled="{Binding HasSelectedService}" />
        <MenuItem Header="削除(_D)..." Command="{Binding DeleteServiceCommand}" IsEnabled="{Binding HasSelectedService}" />
      </MenuItem>
      <MenuItem Header="アカウント(_A)">
        <MenuItem Header="追加(_A)..." Command="{Binding AddAccountCommand}" />
        <MenuItem Header="編集(_E)..." Command="{Binding EditAccountCommand}" CommandParameter="{Binding SelectedAccount}" />
        <MenuItem Header="削除(_D)..." Command="{Binding DeleteAccountCommand}" CommandParameter="{Binding SelectedAccount}" />
        <!-- ID・パスワードのコピーと表示切替は一覧のカードのボタンで行う（利用者の指示でメニューから外した。D-046） -->
      </MenuItem>
      <!-- テーマの切替は ui-settings.json に保存される（D-033）。チェック印はコードビハインドが合わせる -->
      <MenuItem x:Name="ViewMenu" Header="表示(_W)" SubmenuOpened="ViewMenu_SubmenuOpened">
        <!-- 表示 > テーマ > テーマ一覧（D-047）。開くたびに ViewMenu_SubmenuOpened がチェックを合わせる -->
        <MenuItem x:Name="ThemeMenu" Header="テーマ(_T)">
          <MenuItem x:Name="ThemeSystemItem" Header="システム設定に従う(_Y)" IsCheckable="True" Tag="System" Click="ThemeItem_Click" />
          <MenuItem x:Name="ThemeLightItem" Header="ライト(_L)" IsCheckable="True" Tag="Light" Click="ThemeItem_Click" />
          <MenuItem x:Name="ThemeDarkItem" Header="ダーク(_D)" IsCheckable="True" Tag="Dark" Click="ThemeItem_Click" />
          <MenuItem x:Name="ThemeSfItem" Header="SF(_F)" IsCheckable="True" Tag="Sf" Click="ThemeItem_Click" />
        </MenuItem>
        <!-- IsCheckable でチェック印の列を確保し、UIA にもオン／オフを公開する。チェックはメニューを開いたときと保存後にコードビハインドが保管庫の値に合わせる（D-044） -->
        <MenuItem x:Name="CaptureExclusionItem" Header="画面キャプチャから除外(_C)" IsCheckable="True" Click="CaptureExclusionItem_Click"
                  ToolTip="オンにすると、このアプリのウィンドウは画面共有・録画・スクリーンショットに写らなくなります（Windows 10 バージョン 2004 以降）。設定は保管庫の中に保存され、次回は解錠後に適用されます" />
      </MenuItem>
    </Menu>

    <!-- コマンドバー: 検索（先頭に虫めがね）、設定、ロック（メニューにもあるが、利用者の希望で右上にも置く。D-034） -->
    <Grid DockPanel.Dock="Top" Margin="16,8,16,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid>
        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="34,6,10,6" MaxWidth="640" HorizontalAlignment="Left" MinWidth="320"
                 AutomationProperties.Name="検索"
                 ToolTip="サービス名・表示名・ID・メモ・認証方式で検索します（空白区切りで AND 検索、Ctrl+F）" />
        <TextBlock Text="&#xE721;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="14" Foreground="{DynamicResource FluentTextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        <TextBlock Text="サービス名・ID・メモなどで検索（Ctrl+F）" Style="{StaticResource FluentSecondaryText}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVisibility}}" />
      </Grid>
      <Button Grid.Column="1" Content="設定(_T)" Command="{Binding OpenSettingsCommand}" ToolTip="自動ロック・表示時間・コピー消去時間・バックアップ世代数を変更します" />
      <Button Grid.Column="2" Content="ロック(_L)" Command="{Binding LockCommand}" ToolTip="今すぐロックします（Ctrl+L）" />
    </Grid>

    <!-- 状態バー（右端は SF テーマだけの HUD 表示: 解錠中・保存形式） -->
    <Border DockPanel.Dock="Bottom" Padding="16,8" Background="{DynamicResource FluentStatusBarBackgroundBrush}" BorderBrush="{DynamicResource FluentDividerBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Visibility="{DynamicResource FluentHudVisibility}">
          <!-- 点滅はコードビハインドが Windows の「アニメーション効果」設定を見て開始する -->
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource FluentAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="UNLOCKED · vault.dat · AES-256-GCM" Style="{StaticResource FluentHudLabel}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FluentBodyText}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource FluentCriticalText}" Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}" AutomationProperties.LiveSetting="Assertive" />
          <TextBlock Text="保存中…" Style="{StaticResource FluentSecondaryText}" Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Margin="16,0,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- 左: ナビゲーション風のサービス一覧 -->
      <DockPanel>
        <!-- ボタンは文字幅に合わせ（MinWidth=0）、幅が足りないときは折り返す（右端のボタンが見切れないように。D-034） -->
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button Content="＋サービス(_N)" Command="{Binding AddServiceCommand}" MinWidth="0" Margin="0,2,4,2" ToolTip="サービス（Google、Amazon、ゲーム名など）を追加します" />
          <Button Content="名前変更" Command="{Binding RenameServiceCommand}" MinWidth="0" IsEnabled="{Binding HasSelectedService}" ToolTip="選択中のサービス名を変更します" />
          <Button Content="削除" Command="{Binding DeleteServiceCommand}" MinWidth="0" IsEnabled="{Binding HasSelectedService}" ToolTip="選択中のサービスと配下のアカウントを削除します" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource FluentHudLabel}" Text="// SERVICES" Margin="12,0,0,4" />
        <ListBox ItemsSource="{Binding ServiceItems}" SelectedItem="{Binding SelectedServiceItem}" AutomationProperties.Name="サービス一覧" HorizontalContentAlignment="Stretch">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentNavigationItem}">
              <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <!-- 件数バッジは行の塗り（選択・ホバー）と区別できるよう、カード色＋枠線にする -->
                <Border DockPanel.Dock="Right" Background="{DynamicResource FluentCardBackgroundBrush}" BorderBrush="{DynamicResource FluentControlStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentBadgeCornerRadius}" MinWidth="24" Padding="7,0" Margin="8,0,0,0">
                  <TextBlock Text="{Binding CountText}" Style="{StaticResource FluentCaptionText}" FontFamily="{DynamicResource FluentValueFontFamily}" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource FluentTextPrimaryBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsService}" Value="False">
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="True" />

      <!-- 右: 選択中サービスのアカウント（カード） -->
      <DockPanel Grid.Column="2" Margin="8,0,0,0">
        <!-- 見出しとボタンは列を分け、長いサービス名はボタンの下に潜らず省略記号で切る。ボタンのアクセスキーは「アカウント(A)」メニューと重複するため付けない -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Style="{StaticResource FluentHudLabel}" Text="// ACCOUNTS" Margin="0,0,0,2" />
            <TextBlock Text="{Binding SelectedHeading}" Style="{StaticResource FluentSubtitleText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Content="＋追加" Style="{StaticResource FluentAccentButton}" Command="{Binding AddAccountCommand}" VerticalAlignment="Center" Margin="12,2,4,2" ToolTip="アカウントを追加します（アカウントメニューの「追加」と同じ）" />
        </Grid>
        <Grid>
          <ListBox x:Name="AccountList" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                   AutomationProperties.Name="アカウント一覧" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" MouseDoubleClick="AccountList_MouseDoubleClick">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentCardItem}">
                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                      <Button Style="{StaticResource FluentIconButton}" Content="&#xE70F;" AutomationProperties.Name="編集" ToolTip="このアカウントを編集します"
                              Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                      <Button Style="{StaticResource FluentIconButton}" Content="&#xE74D;" AutomationProperties.Name="削除" ToolTip="このアカウントを削除します（確認あり）"
                              Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <!-- 幅が足りないときはバッジを次の行に折り返す -->
                    <WrapPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource FluentTextPrimaryBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding ServiceName}" Style="{StaticResource FluentSecondaryText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                      <Border Background="{DynamicResource FluentSubtleFillSelectedBrush}" BorderBrush="{DynamicResource FluentTagStrokeBrush}" BorderThickness="1" CornerRadius="{DynamicResource FluentBadgeCornerRadius}" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding IsEmailAccount, Converter={StaticResource BoolToVisibility}}" ToolTip="他のアカウントのログインIDとして選択できます">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE715;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12" Foreground="{DynamicResource FluentAccentTextBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="メールアカウント" FontSize="12" Foreground="{DynamicResource FluentAccentTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </WrapPanel>
                  </DockPanel>
                  <controls:SecretField Label="ID" Text="{Binding LoginIdDisplay}" CopyAutomationName="IDをコピー" CopyToolTip="IDをコピーします（一定時間後に自動消去。クリップボード履歴・同期の対象外）"
                                        CopyCommand="{Binding DataContext.CopyIdCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                  <StackPanel Orientation="Horizontal" Margin="2,4,0,0" Visibility="{Binding HasReferenceSource, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="&#xE71B;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12" Foreground="{DynamicResource FluentTextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReferenceSourceText}" Style="{StaticResource FluentCaptionText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <controls:SecretField Label="パスワード" Margin="0,10,0,0" Text="{Binding PasswordDisplay}" ShowRevealButton="True" IsRevealed="{Binding IsRevealed}"
                                        RevealAutomationName="パスワードを表示" HideAutomationName="パスワードを隠す" CopyAutomationName="パスワードをコピー"
                                        CopyToolTip="パスワードを伏せたままコピーします（一定時間後に自動消去。クリップボード履歴・同期の対象外）"
                                        RevealCommand="{Binding DataContext.ToggleRevealCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CopyCommand="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                  <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="12" Foreground="{DynamicResource FluentTextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MfaText}" Style="{StaticResource FluentCaptionText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Notes}" Style="{StaticResource FluentBodyText}" Margin="2,6,0,0" Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                  <TextBlock Text="{Binding UpdatedAtText}" Style="{StaticResource FluentCaptionText}" Margin="2,6,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource FluentIconFontFamily}" FontSize="40" Foreground="{DynamicResource FluentTextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource FluentSecondaryText}" TextAlignment="Center" />
          </StackPanel>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
